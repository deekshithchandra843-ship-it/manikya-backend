# ──────────────────────────────────────────
# Manikya Backend — Environment Variables
# Copy this file to .env and fill in values
# ──────────────────────────────────────────

# Server
PORT=4000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=manikya_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# JWT Secrets (use long random strings in production)
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d
ADMIN_JWT_SECRET=change_this_to_another_long_random_secret
ADMIN_JWT_EXPIRES_IN=1d

# OTP Settings
OTP_EXPIRES_MINUTES=10

# Email (SMTP) — for OTP and magic link emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM="Manikya Services <no-reply@manikya.com>"

# SMS (Twilio) — for phone OTP
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Frontend URL (for magic link redirect)
FRONTEND_URL=http://localhost:5173

# Admin default credentials (only used on first seed)
ADMIN_EMAIL=admin@manikya.com
ADMIN_PASSWORD=change_me_in_production
